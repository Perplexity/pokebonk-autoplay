{
  "name": "pokebonk-autoplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A rule-based player for a local, headless copy of a browser survivors game. Offline only.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dry-run": "node src/main.ts --dry-run",
    "sandbox": "node src/main.ts --sandbox-only",
    "browser": "node src/main.ts --manual",
    "mirror": "node src/sandbox/mirror-cli.ts",
    "sim-poc": "node scripts/sim-poc.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "run-episodes": "node scripts/run-episodes.ts",
    "baseline:report": "node scripts/baseline-report.ts",
    "heuristic:trace": "node scripts/heuristic-trace.ts",
    "env:determinism": "node scripts/env-determinism.ts",
    "env:measure": "node scripts/env-measure.ts",
    "test:env": "node --test \"test/env/*.test.ts\"",
    "export:knowledge": "node scripts/export-knowledge.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0"
  }
}
